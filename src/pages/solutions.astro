---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import ContactBand from '../components/ContactBand.astro';
const solutions=[
 {n:'01',title:'Zone picking',body:'Your people pick. Robots travel between zones, collecting items for separate orders before heading to packing.',items:['Plan zones around locations and pick density.','Guide picks with SKU, quantity, location, and barcode confirmation.','Keep orders in separate bins, with client separation rules.']},
 {n:'02',title:'Order transport',body:'Move completed picks between stations without pulling associates away from their work area.',items:['Define pickup, packing, and return locations.','Choose shelves and totes for your order mix.','Set clear loading, unloading, and exception handoffs.']},
 {n:'03',title:'Material movement',body:'Put repeat trips between workstations on a robot’s task list. Start with a route that has a clear purpose.',items:['Move materials between defined workstations.','Assess replenishment and return transport.','Match the carrying configuration to the load.']}
];
---
<Base title="Warehouse solutions" description="Explore zone picking, order transport, and material movement with packsel warehouse automation for 3PLs.">
<div class="interior">
<section class="page-hero"><p class="page-eyebrow">Solutions for 3PLs.</p><h1>Move the work.<br />Keep people picking.</h1><p class="page-deck"><Brand tm /> brings mobile robots to the trips and handoffs that fill your warehouse day.</p><div class="page-actions"><a class="button button-primary" href="/warehouse-demo/">See the workflow</a><a class="page-link" href="/contact/">Talk about your operation</a></div></section>
<div class="content-wrap"><figure class="media-frame" data-reveal><img src="/images/warehouse-robots.webp" srcset="/images/warehouse-robots-800.webp 800w, /images/warehouse-robots.webp 1440w" sizes="(max-width:1264px) calc(100vw - 64px), 1200px" width="1440" height="960" alt="Shelf-equipped packsel robots transporting cartons and totes through a warehouse aisle" fetchpriority="high" /><figcaption>Product visualization. Final configurations and workflows are defined with your team.</figcaption></figure></div>
<section class="page-section content-wrap"><div class="section-intro" data-reveal><h2>Three ways to<br />take travel off the task list.</h2></div><div class="feature-grid">{solutions.map(s=><article class="feature-card hover-surface" data-reveal><span class="card-number">{s.n}</span><h2>{s.title}</h2><p>{s.body}</p><ul class="simple-list">{s.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
<section class="neutral-band page-section"><div class="content-wrap split-feature"><div class="feature-copy" data-reveal><p class="page-eyebrow">Fit comes first.</p><h2>Designed around<br />your reality.</h2><p>Your floor, systems, and order mix determine what makes sense to automate.</p><a class="page-link" href="/how-it-works/">How we plan a deployment</a></div><ul class="clean-list" data-reveal><li><strong>Floor and traffic</strong>Aisle widths, crossings, floor conditions, and pedestrian routes.</li><li><strong>Orders and inventory</strong>Pick density, item sizes, client rules, and peak demand.</li><li><strong>Systems and connectivity</strong>WMS API access, location data, scanners, and Wi-Fi coverage.</li></ul></div></section>
<ContactBand />
</div>
</Base>
