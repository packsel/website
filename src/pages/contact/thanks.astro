---
import Base from '../../layouts/Base.astro';
---
<Base title="Message sent" description="Thanks for contacting packsel.">
<div class="interior">
<section class="page-hero thanks">
  <span class="asset-tag">Message sent</span>
  <h1>Thanks. It’s with<br />our sales team.</h1>
  <p class="page-deck">We’ll reply to the email address you gave us. If it’s urgent, write to <a href="mailto:sales@packsel.co">sales@packsel.co</a>.</p>
  <div class="page-actions"><a class="button button-primary" href="/">Back to home</a><a class="page-link" href="/warehouse-demo/">Explore the warehouse demo</a></div>
</section>
</div>
</Base>
<style>
  .thanks { padding-bottom: 120px; }
  .thanks .asset-tag { margin-bottom: 24px; }
  .thanks .page-deck a { color: var(--color-accent-text); }
</style>
