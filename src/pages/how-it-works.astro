---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import ContactBand from '../components/ContactBand.astro';
const steps=[{title:'Understand the operation',body:'Start with your floor plan, shifts, order volumes, and the trips your associates make. Identify a workflow worth automating.'},{title:'Define the setup',body:'Review fleet size, carrying configuration, WMS integration, and site readiness. Agree on implementation, lease terms, and support scope.'},{title:'Map, integrate, validate',body:'Plan routes and handoffs, connect the required systems, and test the workflow with your team before expanding its use.'},{title:'Train, operate, improve',body:'Prepare associates to use the robots and handle exceptions. Review performance against your agreed baseline and refine the workflow.'}];
---
<Base title="How it works" description="See how packsel plans robot leasing, integration, and deployment, from floor assessment to daily operation.">
<div class="interior">
<section class="page-hero"><p class="page-eyebrow">From floor plan to fleet.</p><h1>A practical path<br />to automation.</h1><p class="page-deck"><Brand tm /> starts with your operation, then builds a deployment plan around a workflow that fits.</p><div class="page-actions"><a class="button button-primary" href="/contact/">Let’s talk</a></div></section>
<section class="content-wrap" style="padding-bottom:88px"><ol class="deployment-steps">{steps.map((s,i)=><li class="step-card hover-surface" data-reveal><span class="card-number">0{i+1}</span><h2>{s.title}</h2><p>{s.body}</p></li>)}</ol></section>
<section class="neutral-band page-section"><div class="content-wrap split-feature"><div class="feature-copy" data-reveal><p class="page-eyebrow">Before we talk.</p><h2>Bring your questions.<br />And your floor plan.</h2><p>A few details help us understand where robots could make a difference.</p></div><ul class="clean-list" data-reveal><li><strong>Your floor</strong>Layout, aisle widths, and packing locations.</li><li><strong>Your workload</strong>Team size, shifts, and typical order volumes.</li><li><strong>Your systems</strong>WMS, available API, and current scanning process.</li><li><strong>Your priority</strong>The travel or transport task you most want to improve.</li></ul></div></section>
<ContactBand />
</div>
</Base>
