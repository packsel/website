---
import Base from "../layouts/Base.astro";
import Brand from "../components/Brand.astro";
import WarehouseFlow from "../components/WarehouseFlow.astro";
import Arrow from "../components/Arrow.astro";
import ContactBand from "../components/ContactBand.astro";
const steps = [
  {
    title: "Understand your operation",
    body: "Start with your floor plan, shift pattern, order volumes, and the trips your associates make. Identify a workflow worth automating.",
  },
  {
    title: "Define the right setup",
    body: "Review the fleet size, carrying configuration, WMS integration, and site readiness. Agree on implementation, lease terms, and support scope in the proposal.",
  },
  {
    title: "Map, integrate, and validate",
    body: "Plan routes and handoffs, connect the required systems, and test the workflow with your team before expanding its use.",
  },
  {
    title: "Train, operate, and improve",
    body: "Prepare associates to use the robots and handle exceptions. Review performance against your agreed baseline and refine the workflow.",
  },
];
---

<Base
  title="How it works"
  description="From site assessment to operation: how packsel plans warehouse robot leasing, integration, and deployment around your workflow."
>
  <section class="container page-intro">
    <p class="kicker">From floor plan to fleet</p>
    <h1>
      A practical path
      <br />
      to automation.
    </h1>
    <p class="lead">
      Start with a conversation about your warehouse. <Brand tm /> works with
      you to turn a suitable workflow into a deployment plan.
    </p>
  </section>
  <section class="container section">
    <ol class="process-list">
      {steps.map((s, i) => (
        <li>
          <span class="mono step-number">0{i + 1}</span>
          <h2>{s.title}</h2>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="container section-large split">
    <div class="stack">
      <p class="kicker">Before we talk</p>
      <h2>
        Bring your questions.
        <br />
        And your floor plan.
      </h2>
    </div>
    <ul class="simple-list">
      <li>Warehouse layout, aisle widths, and packing locations.</li>
      <li>Employees, shift hours, and typical order volumes.</li>
      <li>WMS name, available API, and current scanning process.</li>
      <li>The travel or transport task you most want to improve.</li>
    </ul>
  </section>
  <section class="surface-sunken section-large">
    <div class="container split">
      <div class="stack">
        <p class="kicker">See the handoffs</p>
        <h2>
          From the shelf.
          <br />
          To the packing station.
        </h2>
        <p class="lead">
          Follow the robot routes in an illustrative zone-picking workflow, then
          explore the people, orders, and handoffs in the interactive demo.
        </p>
        <a class="text-link" href="/warehouse-demo/index.html">
          Explore the warehouse <Arrow diagonal />
        </a>
      </div>
      <WarehouseFlow />
    </div>
  </section>
  <ContactBand />
</Base>
