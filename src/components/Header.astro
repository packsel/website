---
import Arrow from "./Arrow.astro";
import Brand from "./Brand.astro";
const nav = [
  { href: "/solutions/", label: "Solutions" },
  { href: "/robots/", label: "Our robots" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/warehouse-demo/index.html", label: "Warehouse demo" },
  { href: "/savings/", label: "Savings calculator" },
  { href: "/contact/", label: "Let’s talk", cta: true },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label="packsel home">
      <span>
        <Brand tm />
      </span>
      <span class="wordmark-kicker">Automation</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul role="list" class="nav-list">
        {nav.map(({ href, label, cta }) => (
          <li>
            <a
              class:list={{ "nav-cta": cta }}
              href={href}
              aria-current={path === href ? "page" : undefined}
            >
              {label}
              {cta && <Arrow diagonal />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary>
        Menu <span aria-hidden="true">+</span>
      </summary>
      <nav aria-label="Mobile primary">
        <ul role="list">
          {nav.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path === href ? "page" : undefined}>
                {label}
                <Arrow />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (
      menu?.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    )
      menu.open = false;
  });
</script>
<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 88px;
    padding-block: var(--space-4);
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.75rem;
    font-weight: var(--weight-semibold);
    line-height: 1;
  }
  .wordmark-kicker {
    font-family: var(--font-condensed);
    text-transform: uppercase;
    font-size: 0.625rem;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-ink-secondary);
  }
  .nav-list {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }
  .nav-list a {
    display: inline-flex;
    gap: var(--space-5);
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .nav-list .nav-cta {
    border: 1px solid var(--color-border-control);
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
  }
  a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
  }
  .mobile-nav {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-list a:hover {
      text-decoration: underline;
      text-underline-offset: 0.4em;
    }
    .nav-list .nav-cta:hover {
      background: var(--color-surface-sunken);
    }
  }
  @media (max-width: 70rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0;
      min-height: 80px;
      position: relative;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    summary {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-3);
      min-height: 44px;
      cursor: pointer;
      list-style: none;
      font-size: var(--text-sm);
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      font-size: var(--text-lg);
      line-height: 1;
    }
    details[open] {
      width: 100%;
    }
    details[open] summary {
      position: absolute;
      right: var(--container-pad);
      top: var(--space-4);
    }
    details[open] summary span {
      transform: rotate(45deg);
    }
    .mobile-nav nav {
      padding-top: var(--space-5);
    }
    .mobile-nav a {
      display: flex;
      justify-content: space-between;
      padding: var(--space-4) var(--space-3);
      border-top: 1px solid var(--color-border);
      color: var(--color-ink);
      text-decoration: none;
    }
  }
</style>
